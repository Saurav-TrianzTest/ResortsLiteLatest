<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        UPGRADED: Spring Boot parent updated from 3.3.4 to 3.5.3.
        Spring Boot 3.3.x bundles ASM 9.6 which does not recognise Java 25 class-file
        major version 69, causing the spring-boot-maven-plugin repackage goal to fail
        with "Unsupported class file major version 69".
        Spring Boot 3.5.x bundles ASM 9.7+ which fully supports Java 25 bytecode.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>resortsLite</artifactId>
    <version>1.0.0</version>
    <name>ResortsLite</name>
    <description>Resort booking demo — upgraded to Java 25 / Spring Boot 3.5.x</description>

    <properties>
        <!--
            UPGRADED: java.version set to 25.
            The old value caused the compiler to emit Java 8 bytecode even on a Java 25 JDK,
            preventing use of any Java 9-25 language features and APIs.
        -->
        <java.version>25</java.version>
        <!--
            UPGRADED: Use maven.compiler.release instead of the deprecated source/target pair.
            The -release flag enforces both the language level and the API surface of the
            target JDK, preventing accidental use of APIs removed before Java 25.
        -->
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Spring Boot starters — versions managed by spring-boot-starter-parent BOM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            UPGRADED: log4j-core updated from 2.14.1 to 2.23.1.
            Version 2.14.1 has CVE-2021-44228 (Log4Shell) — a critical Remote Code Execution
            vulnerability. Version 2.23.1 is the latest stable release with all CVEs patched.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.23.1</version>
        </dependency>

        <!--
            UPGRADED: commons-collections updated from 3.2.1 to 3.2.2.
            Version 3.2.1 has CVE-2015-6420 — a critical Remote Code Execution vulnerability
            via Java deserialization. Version 3.2.2 patches this vulnerability.
        -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.2</version>
        </dependency>

        <!--
            UPGRADED: Oracle JDBC driver updated from ojdbc8 to ojdbc11 (version 23.4.0.24.05).
            ojdbc8 targets Java 8 and is not certified for Java 25 runtimes.
            ojdbc11 supports Java 11+ and is the recommended driver for Java 25.
        -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.4.0.24.05</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.nls</groupId>
            <artifactId>orai18n</artifactId>
            <version>23.4.0.24.05</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ucp</artifactId>
            <version>23.4.0.24.05</version>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 in-memory database for local development and testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            ADDED: Jakarta Persistence API 3.1.0.
            Spring Boot 3.x / Java 25 uses the Jakarta EE 10 namespace.
            The javax.persistence.* packages were removed; all JPA annotations in
            Doctor.java have been migrated to jakarta.persistence.*.
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!--
            ADDED: Jakarta Servlet API 6.0.0.
            Spring Boot 3.x dropped the javax.servlet.* namespace.
            BookingController.java imports jakarta.servlet.http.HttpSession which
            requires this dependency (provided scope — the container supplies it at runtime).
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot test starter — version managed by BOM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 (Jupiter) – explicit declarations for Java 25 / Maven Surefire 3.x -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                UPGRADED: maven-compiler-plugin updated to 3.13.0 for Java 25 support.
                Older plugin versions (e.g. 3.7.0) do not understand the Java 25 compiler
                flags and will fail with "release version 25 not supported".
                The release element replaces the deprecated source/target pair.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!--
                UPGRADED: maven-surefire-plugin updated to 3.5.3 for Java 25 compatibility.
                Older surefire versions fail to fork a Java 25 JVM for test execution and
                produce "Unsupported class file major version" errors during the test phase.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>

            <!--
                Spring Boot Maven plugin — version managed by spring-boot-starter-parent.
                Spring Boot 3.5.x bundles ASM 9.7+ which supports Java 25 class-file
                major version 69, fixing the repackage failure seen with 3.3.x.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                ADDED: JaCoCo Maven plugin for code coverage reporting.
                Generates coverage reports during the test phase.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
