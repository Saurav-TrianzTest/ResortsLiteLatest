# ── Java / Maven build output ──────────────────────────────
target/
*.jar
*.war
*.ear

# ── Maven wrapper (never needed inside Docker) ─────────────
mvnw
mvnw.cmd
.mvn/

# ── Gradle wrapper (never needed inside Docker) ────────────
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# ── Version control ────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── IDE / editor artefacts ─────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# ── OS artefacts ───────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Documentation ──────────────────────────────────────────
*.md
docs/

# ── CI / CD ────────────────────────────────────────────────
.github/
.circleci/
Jenkinsfile

# ── Docker artefacts (avoid recursive copy) ────────────────
Dockerfile
docker-compose.yml
.dockerignore

# ── Scripts ────────────────────────────────────────────────
scripts/

# ── Kubernetes manifests ───────────────────────────────────
kubernetes/

# ── Test reports ───────────────────────────────────────────
**/surefire-reports/
**/failsafe-reports/
