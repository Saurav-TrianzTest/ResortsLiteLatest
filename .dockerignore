# Java / Maven build artifacts
target/
*.jar
*.war
*.ear

# Git
.git/
.gitignore

# Documentation
*.md
docs/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# Maven wrapper (NEVER copy into Docker image)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (NEVER copy into Docker image)
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# OS files
.DS_Store
Thumbs.db

# Test files
src/test/
**/*Test.java
**/*Tests.java
**/*Spec.java

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp
*~

# Docker files (avoid recursive context)
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts
scripts/

# Kubernetes manifests
kubernetes/
